#include <winver.h>
1 ICON "../assets/icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,0,0,0
 PRODUCTVERSION 3,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Transparency App"
            VALUE "FileDescription", "Transparency App: per-window transparency and screen dimming"
            VALUE "FileVersion", "3.0.0"
            VALUE "InternalName", "TransparencyApp"
            VALUE "LegalCopyright", "Transparency App"
            VALUE "OriginalFilename", "TransparencyApp.exe"
            VALUE "ProductName", "Transparency App"
            VALUE "ProductVersion", "3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
